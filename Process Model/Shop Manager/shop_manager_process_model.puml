@startuml shop_manager_process_model

skinparam shadow false
skinparam packageStyle rectangle
skinparam roundCorner 15
skinparam class {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}

package "Process - Encargado de Tienda" {
  package "Gestion de Registros" as GestionRegistrosPackage {
      class "Registro Tienda" as RegistroTienda <<processClass>> {
      }
      class "Entrada Registro Tienda" as EntradaRegistroTienda <<processClass>> {
        -nombre : String
        -direccion : String
        -telefono : String
        -horario : String
        -foto : Image
        --
        -validarDatos()
      }
      class "Confirmacion Registro Tienda" as ConfirmacionRegistroTienda <<processClass>> {
        -crearSolicitud()
      }
      class "Error Registro Tienda" as ErrorRegistroTienda <<processClass>> {
        -message : String
      }
  }

  package "Gestion de Espacios" as GestionEspaciosPackage {
      class "Gestion Espacios" as GestionEspacios <<processClass>> {
      }
      class "Lista Espacios" as ListaEspacios <<processClass>> {
      }
      class "Crear Espacio" as CrearEspacio <<processClass>> {
      }
      class "Actualizar Espacio" as ActualizarEspacio <<processClass>> {
      }
      class "Eliminar Espacio" as EliminarEspacio <<processClass>> {
      }
      class "Validar Eliminacion Espacio" as ValidarEliminacionEspacio <<processClass>> {
        -espacioId : UUID
        --
        -validarDependencias()
      }

      class "Asignar Espacio" as AsignarEspacio <<processClass>> {
      }
      class "Entrada Datos Espacio" as EntradaDatosEspacio <<processClass>> {
        -codigo : String
        -descripcion : String
        -ubicacion : String
        -estado : String
        --
        -validarDatos()
      }
      class "Entrada Asignacion Espacio" as EntradaAsignacionEspacio <<processClass>> {
        -emprendimientoId : UUID
        --
        -validarAsignacion()
      }
  }

  package "Gestion de Reportes" as GestionReportesPackage {
      class "Generacion Reportes" as GeneracionReportes <<processClass>> {
      }
      class "Entrada Filtro Reporte" as EntradaFiltroReporte <<processClass>> {
        -tipo : String
        -fechaInicio : Date
        -fechaFin : Date
        -emprendimientoId : UUID
        -tipoMovimiento : String
        -incluirVentas : Boolean
      }
      class "Construccion Reporte" as ConstruccionReporte <<processClass>> {
        -compilarDatos()
      }
      class "Exportar Reporte PDF" as ExportarReportePDF <<processClass>> {
        -exportarPdf()
      }
  }

  package "Gestion De Inventario" as GestionInventariosPackage {
        class "Revision Stock" as RevisionStock <<processClass>> {
        }
        class "Entrada Filtro Stock" as EntradaFiltroStock <<processClass>> {
          -emprendimientoId : UUID
          -criterio : String
        }
        class "Lista Stock" as ListaStock <<processClass>> {
        }

        rectangle "Registro Ventas" {
        class "Registro Ventas" as RegistroVentas <<processClass>> {
          }
          class "Entrada Ventas" as EntradaVentas <<processClass>> {
            -emprendimientoId : UUID
            -items : String
            --
            -validarVenta()
          }
          class "Confirmacion Venta" as ConfirmacionVenta <<processClass>> {
            -guardarVenta()
            -reducirStock()
          }

          class "Movimiento Inventario" as MovimientoInventario <<processClass>> {
          }
          class "Entrada Movimiento Inventario" as EntradaMovimientoInventario <<processClass>> {
            -productoId : UUID
            -tipo : String
            -cantidad : Integer
            -motivo : String
            --
            -validarMovimiento()
          }
          class "Confirmacion Movimiento Inventario" as ConfirmacionMovimientoInventario <<processClass>> {
            -aplicarMovimiento()
          }
      }
    }

  class "Error Validacion" as ErrorValidacion <<processClass>> {
    -message : String
  }

  RegistroTienda *-- EntradaRegistroTienda
  RegistroTienda *-- ConfirmacionRegistroTienda
  EntradaRegistroTienda --> ErrorRegistroTienda

  GestionEspacios *-- ListaEspacios
  GestionEspacios *-- CrearEspacio
  GestionEspacios *-- ActualizarEspacio
  GestionEspacios *-- EliminarEspacio
  GestionEspacios *-- AsignarEspacio

  CrearEspacio *-- EntradaDatosEspacio
  ActualizarEspacio *-- EntradaDatosEspacio
  AsignarEspacio *-- EntradaAsignacionEspacio
  EntradaDatosEspacio --> ErrorValidacion
  EntradaAsignacionEspacio --> ErrorValidacion
  EliminarEspacio --> ValidarEliminacionEspacio

  RevisionStock *-- EntradaFiltroStock
  RevisionStock *-- ListaStock

  GeneracionReportes *-- EntradaFiltroReporte
  GeneracionReportes *-- ConstruccionReporte
  GeneracionReportes *-- ExportarReportePDF
  EntradaFiltroReporte --> ErrorValidacion

  RegistroVentas *-- EntradaVentas
  RegistroVentas *-- ConfirmacionVenta
  EntradaVentas --> ErrorValidacion

  RegistroVentas "1" -- "1" MovimientoInventario

  MovimientoInventario *-- EntradaMovimientoInventario
  MovimientoInventario *-- ConfirmacionMovimientoInventario
  EntradaMovimientoInventario -left-> ErrorValidacion

 GestionRegistrosPackage -[hidden]right-> GestionEspaciosPackage
 GestionEspaciosPackage -[hidden]right-> GestionReportesPackage
 GestionReportesPackage -[hidden]left-> GestionEspaciosPackage

 GestionInventariosPackage -[hidden]left-> ErrorValidacion
 GestionRegistrosPackage -[hidden]down-> GestionInventariosPackage
 GestionEspaciosPackage -[hidden]down-> GestionInventariosPackage
 GestionReportesPackage -[hidden]down-> GestionInventariosPackage
 EntradaDatosEspacio -[hidden]down-> GestionInventariosPackage
}
@enduml
